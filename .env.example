# npm run dev uses local mode; npm start enables production mode.
PORT=4100

ADMIN_USERNAME=
ADMIN_PASSWORD=
# Generate with: openssl rand -hex 32
ADMIN_SESSION_SECRET=
# Required in production; exact public HTTPS origin, without a path.
ADMIN_ORIGIN=http://localhost:5173
# Production always uses Secure cookies.
ADMIN_COOKIE_SECURE=false
# Leave empty for a direct connection. Otherwise list only trusted proxy IPs/CIDRs.
TRUST_PROXY=

FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=""
FIREBASE_CLIENT_EMAIL=
FIREBASE_DATABASE_URL=

# Optional: all three are required when using a separate messaging project.
FCM_FIREBASE_PROJECT_ID=
FCM_FIREBASE_CLIENT_EMAIL=
FCM_FIREBASE_PRIVATE_KEY=""
